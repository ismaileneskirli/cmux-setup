<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eneskirli.cmux-sidebar-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/cmux-sidebar-dashboard</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CMUX_SOCKET_PATH</key>
    <string>__HOME__/.local/state/cmux/cmux-__UID__.sock</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.cache/cmux-dashboard/launch-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cache/cmux-dashboard/launch-agent.error.log</string>
</dict>
</plist>
